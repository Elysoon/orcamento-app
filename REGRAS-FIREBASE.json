{
  "orcamento_web": {
    "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && auth.uid === $uid"
    }
  },
  "usuarios": {
    ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
    "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && auth.uid === $uid"
    }
  },
  "licencas": {
    ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
    "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.child('origem').val() === 'voucher' && newData.parent().parent().child('vouchers').child(newData.child('voucher').val()).child('usadoPor').val() === auth.uid && !root.child('vouchers').child(newData.child('voucher').val()).child('usadoPor').exists()))"
    }
  },
  "vouchers": {
    ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
    ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
    "$codigo": {
      ".read": "auth != null",
      "usadoPor": {
        ".write": "auth != null && data.parent().exists() && !data.exists() && newData.val() === auth.uid"
      },
      "usadoEm": {
        ".write": "auth != null && !data.exists() && newData.parent().child('usadoPor').val() === auth.uid"
      }
    }
  },
  "admins": {
    "$uid": {
      ".read": "auth != null && auth.uid === $uid"
    }
  }
}
